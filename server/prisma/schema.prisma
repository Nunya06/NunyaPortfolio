generator client {
    provider = "prisma-client"
    output   = "../generated/prisma"
}

datasource db {
    provider = "postgresql"
}

// User model for admin authentication
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

// Hero section content
model Hero {
  id                  String   @id @default(uuid())
  badgeText           String
  heading             String
  subheading          String
  image               String?
  primaryButtonText   String
  primaryButtonLink   String
  secondaryButtonText String
  secondaryButtonLink String
  footerText          String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("hero")
}


// Projects
model Project {
  id           String   @id @default(uuid())
  title        String
  category     String
  description  String
  technologies String[]
  images       String[]
  link      String?
  status       String   @default("Completed")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("projects")
}

// Services
model Service {
  id          String   @id @default(uuid())
  title       String
  description String
  image       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("services")
}

// Testimonials
model Testimonial {
  id        String   @id @default(uuid())
  name      String
  role      String?
  message   String
  image     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("testimonials")
}

// Skills
model Skill {
  id        String   @id @default(uuid())
  name      String
  level     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("skills")
}

// Experience
model Experience {
  id          String   @id @default(uuid())
  company     String
  role        String
  startDate   DateTime
  endDate     DateTime?
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("experience")
}

// Contact Information
model Contact {
  id        String   @id @default(uuid())
  email     String
  phone     String
  location  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("contact")
}

// Social Links
model SocialLink {
  id        String   @id @default(uuid())
  name      String
  url       String
  image     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("social_links")
}

// message from client
model Message {
  id        String   @id @default(uuid())
  name      String
  email     String
  subject   String?
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("messages")
}